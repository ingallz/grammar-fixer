{
  "manifest_version": 3,
  "name": "Grammar Fixer (local Gemini)",
  "version": "1.0.0",
  "description": "Fix grammar & sentence structure in the focused input using local Gemini CLI.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fix-grammar": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Fix grammar in focused field (or selected text)"
    }
  }
}